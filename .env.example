# Backend origin WITHOUT /v1 (the client adds it). The backend must list this app's origin in CORS_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=https://api.tradexai.pro

# Used for the "Open in Telegram" link, the OTP bot link and referral invite links
# (https://t.me/<bot>/<app>?startapp=<referralCode>). Leave empty to show the bare referral code.
NEXT_PUBLIC_BOT_USERNAME=TRADExAIAppbot
NEXT_PUBLIC_MINI_APP_SHORT_NAME=TradeXAI
